rules_version = '2';
// Owner-only: a signed-in user can read/write ONLY files under users/{uid}/.
// Uploads must be images or JSON and under 15 MB. Everything else is closed.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/json');
    }
  }
}
